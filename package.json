{
  "name": "rill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "worker:dev": "vite build && wrangler dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint:privacy": "node scripts/check-privacy.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run lint:privacy",
    "setup:local": "node scripts/setup-local.mjs",
    "deploy": "npm run verify && wrangler d1 migrations apply rill --remote && wrangler deploy"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.12.1",
    "htmlparser2": "^12.0.0",
    "idb": "^8.0.4",
    "linkedom": "^0.18.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
